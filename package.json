{
  "name": "android-sqlite-mcp",
  "version": "1.0.5",
  "description": "A Model Context Protocol (MCP) server to connect AI agents directly to the embedded SQLite/Room databases of your Android applications.",
  "main": "build/index.js",
  "bin": {
    "android-sqlite-mcp": "./build/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "files": [
    "build"
  ],
  "keywords": [
    "mcp",
    "android",
    "sqlite",
    "ai",
    "claude",
    "cursor"
  ],
  "author": "Felicks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Feliicks/android-sqlite-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Feliicks/android-sqlite-mcp/issues"
  },
  "homepage": "https://github.com/Feliicks/android-sqlite-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.2",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@types/pino": "^7.0.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
